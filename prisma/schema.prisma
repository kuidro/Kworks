generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ADMIN
  EVALUADOR
}

enum EstadoProceso {
  BORRADOR
  ABIERTO
  EN_PROGRESO
  CERRADO
}

enum EstadoPostulacion {
  PENDIENTE
  SELECCIONADO
  DESCARTADO
}

enum EstadoCandidato {
  EN_PRUEBA
  EN_ENTREVISTAS
  COMPLETADO
  DESCARTADO
}

enum EstadoEtapa {
  PENDIENTE
  ACTIVA
  COMPLETADA
}

enum Decision {
  AVANZA
  TERMINA
}

model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol      @default(EVALUADOR)
  creadoEn  DateTime @default(now())

  etapas EtapaEvaluacion[]
}

model TipoProceso {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?
  activo      Boolean @default(true)
  creadoEn    DateTime @default(now())

  procesos      Proceso[]
  postulaciones Postulacion[]
}

model Proceso {
  id            String        @id @default(cuid())
  nombre        String
  tipoProcesoId String
  tipoProceso   TipoProceso   @relation(fields: [tipoProcesoId], references: [id])
  estado        EstadoProceso @default(BORRADOR)
  descripcion   String?
  fechaInicio   DateTime?
  fechaFin      DateTime?
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  postulaciones Postulacion[]
  candidatos    CandidatoEnProceso[]
}

model Postulacion {
  id            String            @id @default(cuid())
  procesoId     String
  proceso       Proceso           @relation(fields: [procesoId], references: [id])
  tipoProcesoId String
  tipoProceso   TipoProceso       @relation(fields: [tipoProcesoId], references: [id])
  nombre        String
  apellido1     String
  apellido2     String?
  rut           String
  email         String
  universidad   String
  carrera       String
  rankingNotas  String?
  respuesta1    String
  respuesta2    String
  cvNombre      String?
  cvRuta        String?
  estado        EstadoPostulacion @default(PENDIENTE)
  creadoEn      DateTime          @default(now())

  candidatoEnProceso CandidatoEnProceso?
}

model CandidatoEnProceso {
  id            String          @id @default(cuid())
  procesoId     String
  proceso       Proceso         @relation(fields: [procesoId], references: [id])
  postulacionId String          @unique
  postulacion   Postulacion     @relation(fields: [postulacionId], references: [id])
  estado        EstadoCandidato @default(EN_PRUEBA)
  notas         String?
  creadoEn      DateTime        @default(now())

  prueba   PruebaOnline?
  etapas   EtapaEvaluacion[]
}

model PruebaOnline {
  id                   String             @id @default(cuid())
  candidatoEnProcesoId String             @unique
  candidatoEnProceso   CandidatoEnProceso @relation(fields: [candidatoEnProcesoId], references: [id], onDelete: Cascade)
  fechaHora            DateTime?
  puntaje              Float?
  observaciones        String?
  completada           Boolean            @default(false)
}

model EtapaEvaluacion {
  id                   String             @id @default(cuid())
  candidatoEnProcesoId String
  candidatoEnProceso   CandidatoEnProceso @relation(fields: [candidatoEnProcesoId], references: [id], onDelete: Cascade)
  evaluadorId          String
  evaluador            Usuario            @relation(fields: [evaluadorId], references: [id])
  orden                Int
  estado               EstadoEtapa        @default(PENDIENTE)
  decision             Decision?
  comentarioGeneral    String?
  completadoEn         DateTime?

  competencias EtapaCompetencia[]
}

model Competencia {
  id          String  @id @default(cuid())
  nombre      String
  descripcion String?

  etapas EtapaCompetencia[]
}

model EtapaCompetencia {
  id            String          @id @default(cuid())
  etapaId       String
  etapa         EtapaEvaluacion @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  competenciaId String
  competencia   Competencia     @relation(fields: [competenciaId], references: [id])
  puntaje       Int?
  comentario    String?
}
